[gd_resource type="Resource" script_class="RecipeDef" format=3]

[ext_resource type="Script" path="res://scripts/resources/material_stack.gd" id="1_stack"]
[ext_resource type="Script" path="res://scripts/resources/recipe_def.gd" id="2_rec"]

[sub_resource type="Resource" id="Resource_ground"]
script = ExtResource("1_stack")
material = "game:item/coffee_ground"
amount = 1

[sub_resource type="Resource" id="Resource_water"]
script = ExtResource("1_stack")
material = "game:item/water"
amount = 1

[resource]
script = ExtResource("2_rec")
output = "game:item/espresso"
inputs = Array[ExtResource("1_stack")]([SubResource("Resource_ground"), SubResource("Resource_water")])
duration_seconds = 20.0
facility = "game:facility/coffee_machine"
order = 4
group = "drink"
id = "recipe/espresso"
display_name = "data.recipe.espresso.name"
description = "data.recipe.espresso.desc"
allow_batches = true
