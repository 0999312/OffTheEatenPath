[gd_resource type="Resource" script_class="LetterDef" format=3]

[ext_resource type="Script" path="res://scripts/resources/material_stack.gd" id="1_stack"]
[ext_resource type="Script" path="res://scripts/resources/letter_def.gd" id="2_letter"]

[sub_resource type="Resource" id="Resource_reward"]
script = ExtResource("1_stack")
material = "game:item/coffee_bean"
amount = 5

[resource]
script = ExtResource("2_letter")
title = "data.letter.window.title"
body = "data.letter.window.body"
order = 1
rewards = Array[ExtResource("1_stack")]([SubResource("Resource_reward")])
id = "letter/window"
display_name = "data.letter.window.name"
description = "data.letter.window.desc"
handwriting = "unknown"
